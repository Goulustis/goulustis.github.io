{% assign collection_name = include.collection | default: 'news' %}
<div class="news">
  {% assign items = site[collection_name] %}
  {% if items != blank %}
    {% assign items_size = items | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and items_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign items = items | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign items_limit = page.announcements.limit %}
        {% else %}
          {% assign items_limit = items_size %}
        {% endif %}
        {% for item in items limit: items_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No {{ collection_name }} so far...</p>
  {% endif %}
</div>